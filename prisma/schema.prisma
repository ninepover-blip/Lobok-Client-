generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  username          String            @unique
  passwordHash      String
  role              Role              @default(USER)
  avatarUrl         String?
  telegramId        String?           @unique
  telegramUsername  String?
  is2FAEnabled      Boolean           @default(false)
  twoFACode         String?
  twoFACodeExpires  DateTime?
  hwid              String?
  ip                String?
  isBanned          Boolean           @default(false)
  banExpiresAt      DateTime?
  isMuted           Boolean           @default(false)
  muteExpiresAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  previousUsername  String?
  lastSeenAt        DateTime?
  playtimeMinutes   Int               @default(0)
  telegramLinkCode  String?           @unique
  telegramLinkExp   DateTime?
  /// Код восстановления пароля — присылается в Telegram
  resetCode         String?
  resetCodeExpires  DateTime?
  messages          ChatMessage[]
  downloadStats     DownloadStat[]
  freeKeyClaims     FreeKeyClaim[]
  createdKeys       LicenseKey[]      @relation("KeyCreator")
  keys              LicenseKey[]      @relation("KeyOwner")
  news              News[]
  payments          Payment[]
  sessions          PlaySession[]
  promoRedemptions  PromoRedemption[]
  issuedPunishments Punishment[]      @relation("PunishmentIssuer")
  punishments       Punishment[]      @relation("PunishmentTarget")
  serverStats       ServerStat[]
  assignedTickets   SupportTicket[]   @relation("TicketAssignee")
  tickets           SupportTicket[]   @relation("TicketAuthor")
}

/// Игровая сессия в клиенте: лаунчер шлёт heartbeat, отсюда считаются часы
/// и «топ серверов, на которых играет игрок».
model PlaySession {
  id        String    @id @default(cuid())
  userId    String
  minutes   Int       @default(0)
  serverIp  String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startedAt])
}

/// Заказ на покупку ключа (автооплата).
model Payment {
  id              String           @id @default(cuid())
  userId          String
  amountRub       Int
  amountUah       Int
  createdAt       DateTime         @default(now())
  confirmedById   String?
  issuedKeyId     String?          @unique
  keyType         KeyType
  /// Уникальная метка платежа — покупатель указывает её в комментарии к переводу
  label           String           @unique
  operationId     String?
  paidAt          DateTime?
  updatedAt       DateTime         @updatedAt
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  cancelReason    String?
  cancelledAt     DateTime?
  /// Кто и почему отменил заказ (для отмены уже выданной покупки)
  cancelledById   String?
  /// Полная цена по тарифу до скидки — для истории и отчётов
  fullAmountRub   Int?
  fullAmountUah   Int?
  promoCode       String?
  promoDiscount   Int?
  /// Применённый промокод: цена в amountRub/amountUah уже со скидкой
  promoId         String?
  payerName       String?
  paymentTime     String?
  receiptData     String?
  promo           Promo?           @relation(fields: [promoId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoRedemption PromoRedemption?

  @@index([userId])
  @@index([status])
  @@index([label])
}

model LicenseKey {
  id            String        @id @default(cuid())
  key           String        @unique
  type          KeyType
  status        KeyStatus     @default(UNUSED)
  durationDays  Int?
  priceRub      Int?
  priceUah      Int?
  ownerId       String?
  ownerUsername String?
  hwid          String?
  ip            String?
  activatedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?
  revokedAt     DateTime?
  revokedReason String?
  freeClaim     FreeKeyClaim?
  createdBy     User?         @relation("KeyCreator", fields: [createdById], references: [id])
  owner         User?         @relation("KeyOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([key])
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  mediaUrls String[]
  mediaType String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPinned  Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

model ChatMessage {
  id          String         @id @default(cuid())
  channel     Channel        @default(GLOBAL)
  ticketId    String?
  userId      String
  content     String
  isPinned    Boolean        @default(false)
  isDeleted   Boolean        @default(false)
  deletedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ticket      SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel])
  @@index([ticketId])
  @@index([userId])
}

model SupportTicket {
  id          String        @id @default(cuid())
  title       String
  description String
  authorId    String
  assigneeId  String?
  status      TicketStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  assignee    User?         @relation("TicketAssignee", fields: [assigneeId], references: [id])
  author      User          @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([status])
}

model Punishment {
  id          String         @id @default(cuid())
  type        PunishmentType
  targetId    String?
  targetIp    String?
  moderatorId String
  reason      String?
  duration    String?
  durationMs  BigInt?
  expiresAt   DateTime?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  moderator   User           @relation("PunishmentIssuer", fields: [moderatorId], references: [id], onDelete: Cascade)
  target      User?          @relation("PunishmentTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([targetIp])
  @@index([type])
}

model ServerStat {
  id          String   @id @default(cuid())
  ip          String   @unique
  count       Int      @default(1)
  lastSeenAt  DateTime @default(now())
  firstSeenAt DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([ip])
}

model DownloadStat {
  id        String   @id @default(cuid())
  userId    String?
  ip        String?
  version   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model FreeKeyClaim {
  id        String     @id @default(cuid())
  userId    String
  keyId     String     @unique
  claimedAt DateTime   @default(now())
  ip        String?
  key       LicenseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([claimedAt])
}

model Release {
  id               String   @id @default(cuid())
  type             String
  version          String
  originalFilename String
  filePath         String
  fileSize         Int
  mimeType         String?
  isLatest         Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  fileData         Bytes?

  @@unique([type, version])
  @@index([type, isLatest])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Промокод на скидку. Создаётся админом, вводится покупателем при оплате.
model Promo {
  id           String            @id @default(cuid())
  /// Название промокода. Хранится в верхнем регистре, сравнение регистронезависимое.
  code         String            @unique
  /// Размер скидки в процентах, 1..100
  discount     Int
  /// Сколько дней промокод активен с момента создания. null = бессрочно.
  durationDays Int?
  /// Дата, после которой промокод не действует. null = бессрочно.
  expiresAt    DateTime?
  /// Максимальное количество использований. null = без ограничения.
  maxUses      Int?
  /// Сколько раз уже использован (инкрементится при выдаче ключа).
  uses         Int               @default(0)
  /// Можно ли выключить промокод, не удаляя его.
  isActive     Boolean           @default(true)
  comment      String?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  payments     Payment[]
  redemptions  PromoRedemption[]

  @@index([code])
  @@index([isActive])
}

/// Факт применения промокода к оплаченному заказу.
/// Отдельная таблица нужна, чтобы один человек не активировал один код много раз.
model PromoRedemption {
  id        String   @id @default(cuid())
  promoId   String
  userId    String
  paymentId String   @unique
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
  @@index([promoId])
  @@index([userId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum KeyType {
  D30
  D90
  FOREVER
  FREE
  D1
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
  UNUSED
}

enum PunishmentType {
  MUTE
  BAN
  WARN
  IP_BAN
}

enum TicketStatus {
  OPEN
  CLOSED
  PENDING
}

enum Channel {
  GLOBAL
  SUPPORT
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  YOOMONEY
  CARD_RU
  MONO_UA
  IBAN_UA
}
